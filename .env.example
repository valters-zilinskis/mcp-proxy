# Public URL that clients use to reach this proxy
PUBLIC_URL=https://your-domain.example

# Strong secret required for the /admin/* endpoints
ADMIN_TOKEN=replace-with-strong-admin-token

# Token that clients present after the fake OAuth flow
FIXED_TOKEN=replace-with-strong-client-token

# Optional allowlist for redirect_uri values accepted by /authorize
# Comma-separated absolute URLs. Leave empty to allow any redirect URI.
OAUTH_REDIRECT_ALLOWLIST=

# Show registered MCP keys in /health output
# Keep false for public deployments.
HEALTH_SHOW_SERVERS=false

# Where the registered MCP servers are persisted
DATA_FILE=./servers.json

# Port used by `next dev` / `next start`
PORT=8787
